# Copy to .env (gitignored) and fill in a real key for local development.
# Auto-loaded at backend startup — no need to export/source it yourself.
# Alternative: `dotnet user-secrets set OPENAI_API_KEY <value>` from backend/.
OPENAI_API_KEY=

# Optional: swap the cascade's machine-translation provider (#17).
# Valid values: openai (default), anthropic.
#TRANSLATION_PROVIDER=anthropic
# Required when TRANSLATION_PROVIDER=anthropic.
#ANTHROPIC_API_KEY=
# Optional model override for the Anthropic MT provider
# (default: claude-haiku-4-5, chosen for latency parity with gpt-4o-mini).
#ANTHROPIC_MT_MODEL=
